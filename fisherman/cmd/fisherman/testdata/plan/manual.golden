      {
        "field": "source.digest",
        "reason": "the install reads the image identity when it pulls or opens the image; plan reads it only with --read-image"
      },
      {
        "field": "source.pull",
        "reason": "whether the image is in a local store or must be pulled is known only when the install checks the image cache"
      },
      {
        "field": "source.media_input",
        "reason": "on live media the install first binds the verified media input (probe media_input), which can replace the source; plan does not verify it"
      },
      {
        "field": "capacity.root_need_bytes",
        "reason": "the estimate is the image's unpacked size, which is unknown (see image.unpacked_bytes)"
      },
      {
        "field": "partitions[1].size_bytes",
        "reason": "lsblk reports no size for the partition"
      },
      {
        "field": "partitions[1].disk",
        "reason": "lsblk does not report the partition, so plan cannot tell which disk it is on"
      },
      {
        "field": "partitions[3].filesystem",
        "reason": "a kept partition is mounted with the filesystem it holds; plan does not read it"
      },
      {
        "field": "capacity.root_minimum",
        "reason": "fisherman sets no root minimum; root_need_bytes and image_fit compare the root with the image"
      },
      {
        "field": "scratch.bytes",
        "reason": "the exact scratch use depends on the path the install takes (a pull, an OCI export, a redirected store); scratch.need_bytes is an upper estimate"
      },
      {
        "field": "scratch.need_bytes",
        "reason": "the estimate needs the image's compressed and unpacked sizes (image.compressed_bytes, image.unpacked_bytes)"
      },
      {
        "field": "scratch.fit",
        "reason": "plan has no scratch estimate (see scratch.need_bytes)"
      },
      {
        "field": "capacity.image_fit",
        "reason": "plan has no size of the image (see image)"
      }
    ]
  }
