ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Install and enable SSH for all supported distributions
RUN if command -v dnf >/dev/null 2>&1; then \
      # RHEL/CentOS/Fedora
      dnf install -y openssh-server openssh-clients && \
      systemctl enable sshd; \
    elif command -v apt-get >/dev/null 2>&1; then \
      # Debian/Ubuntu - initialize dpkg/apt structure first (needed for minimal debian-bootc)
      mkdir -p /var/lib/dpkg/status.d /var/lib/apt/lists/partial /var/cache/apt/archives/partial /var/log/apt && \
      touch /var/lib/dpkg/status /var/lib/apt/extended_states && \
      apt-get update && \
      apt-get install -y openssh-server && \
      systemctl enable ssh; \
    elif command -v pacman >/dev/null 2>&1; then \
      # Arch
      pacman -Sy --noconfirm openssh && \
      systemctl enable sshd; \
    elif command -v zypper >/dev/null 2>&1; then \
      # openSUSE
      zypper install -y openssh && \
      systemctl enable sshd; \
    else \
      echo "WARNING: Unsupported distribution, SSH installation may have failed"; \
    fi

# CI injects an ephemeral public key into the installed target before boot.
# Do not bake reusable root credentials into images published to GHCR.
RUN echo "PermitRootLogin prohibit-password" >> /etc/ssh/sshd_config && \
    echo "PasswordAuthentication no" >> /etc/ssh/sshd_config && \
    echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config

# Generate SSH host keys (required for sshd to start)
RUN ssh-keygen -A 2>/dev/null || (mkdir -p /etc/ssh && \
    ssh-keygen -t rsa -N "" -f /etc/ssh/ssh_host_rsa_key && \
    ssh-keygen -t ed25519 -N "" -f /etc/ssh/ssh_host_ed25519_key && \
    ssh-keygen -t dsa -N "" -f /etc/ssh/ssh_host_dsa_key && \
    ssh-keygen -t ecdsa -N "" -f /etc/ssh/ssh_host_ecdsa_key)

# Enable SSH service using systemctl enable (creates symlinks for bootc OSTree)
# Also create explicit targets for composefs to ensure SSH starts
RUN if command -v systemctl >/dev/null 2>&1; then \
      if [ -f /usr/lib/systemd/system/sshd.service ]; then \
        systemctl enable sshd.service || true; \
      elif [ -f /usr/lib/systemd/system/ssh.service ]; then \
        systemctl enable ssh.service || true; \
      fi; \
    fi

# For composefs: also ensure service files are linked in /etc/systemd/system/
# as a fallback in case the image's enable didn't create them
RUN mkdir -p /etc/systemd/system/multi-user.target.wants && \
    if [ -f /usr/lib/systemd/system/sshd.service ] && [ ! -e /etc/systemd/system/multi-user.target.wants/sshd.service ]; then \
      ln -sf /usr/lib/systemd/system/sshd.service /etc/systemd/system/multi-user.target.wants/sshd.service || true; \
    fi && \
    if [ -f /usr/lib/systemd/system/ssh.service ] && [ ! -e /etc/systemd/system/multi-user.target.wants/ssh.service ]; then \
      ln -sf /usr/lib/systemd/system/ssh.service /etc/systemd/system/multi-user.target.wants/ssh.service || true; \
    fi

# Minimal bootc images like Debian ship systemd-networkd but no active network
# manager, so SSH comes up without any guest NIC being configured. Provide a
# basic DHCP config and enable networkd when NetworkManager is absent.
RUN if [ ! -f /usr/lib/systemd/system/NetworkManager.service ] && [ -f /usr/lib/systemd/system/systemd-networkd.service ]; then \
      mkdir -p /etc/systemd/network /etc/systemd/system/multi-user.target.wants && \
      printf '[Match]\nName=en* eth*\n\n[Network]\nDHCP=yes\nLinkLocalAddressing=yes\nIPv6AcceptRA=yes\n' > /etc/systemd/network/20-wired.network && \
      ln -sf /usr/lib/systemd/system/systemd-networkd.service /etc/systemd/system/multi-user.target.wants/systemd-networkd.service && \
      ln -sf /usr/lib/systemd/system/systemd-networkd.service /etc/systemd/system/dbus-org.freedesktop.network1.service; \
    fi

# Disable systemd-firstboot: it runs interactively on /dev/console before
# sysinit.target, blocking all other services (including sshd) until the
# user completes the first-boot wizard. Pre-configure the minimum required
# settings (timezone, locale) so the ConditionFirstBoot= check passes cleanly.
RUN ln -sf /usr/share/zoneinfo/UTC /etc/localtime && \
    echo "UTC" > /etc/timezone 2>/dev/null || true
RUN mkdir -p /etc/systemd/system && \
    ln -sf /dev/null /etc/systemd/system/systemd-firstboot.service

# Ensure SSH is installed
RUN test -f /usr/sbin/sshd || test -f /usr/bin/sshd || \
    (echo "ERROR: SSH installation failed" && exit 1)
