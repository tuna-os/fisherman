<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="TunaConfirm" parent="AdwBin">
    <child>
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-title">false</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwClamp">
            <property name="maximum-size">480</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">24</property>
                <property name="valign">center</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <child>
                  <object class="GtkImage">
                    <property name="icon-name">dialog-warning-symbolic</property>
                    <property name="pixel-size">64</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Ready to Install</property>
                    <attributes>
                      <attribute name="weight" value="bold"/>
                      <attribute name="scale" value="1.5"/>
                    </attributes>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">All data on the selected disk will be permanently erased. Please confirm the installation settings below.</property>
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Disk</property>
                        <child type="suffix">
                          <object class="GtkLabel" id="disk_label">
                            <property name="label">—</property>
                            <style><class name="dim-label"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Filesystem</property>
                        <child type="suffix">
                          <object class="GtkLabel" id="filesystem_label">
                            <property name="label">—</property>
                            <style><class name="dim-label"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Encryption</property>
                        <child type="suffix">
                          <object class="GtkLabel" id="encryption_label">
                            <property name="label">—</property>
                            <style><class name="dim-label"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Hostname</property>
                        <child type="suffix">
                          <object class="GtkLabel" id="hostname_label">
                            <property name="label">—</property>
                            <style><class name="dim-label"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title">Image</property>
                        <child type="suffix">
                          <object class="GtkLabel" id="image_label">
                            <property name="label">—</property>
                            <property name="ellipsize">end</property>
                            <style><class name="dim-label"/></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="halign">center</property>
                    <property name="spacing">12</property>
                    <child>
                      <object class="GtkButton" id="btn_back">
                        <property name="label">Back</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="btn_install">
                        <property name="label">Install Now</property>
                        <style>
                          <class name="destructive-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
